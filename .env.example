# ──────────────────────────────────────────────────────────────
# Payback — variables d'environnement (exemple)
# Copier ce fichier en `.env` et remplir les valeurs.
# Aucune de ces variables n'est requise pour lancer l'app en local
# dans son état actuel (placeholders), elles préparent l'étape suivante.
# ──────────────────────────────────────────────────────────────

# Base de données (PostgreSQL / Supabase) — SEULE variable requise à ce stade.
# Correspond au docker-compose.yml fourni (Postgres local).
DATABASE_URL="postgresql://payback:payback@localhost:5432/payback?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Étapes futures (laisser vide pour l'instant) ──────────────
# Auth (Supabase)
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Email (Resend) — envoi réel en mode test sécurisé.
# Voir docs/EMAIL_DELIVERY.md. Ne jamais committer de vraie valeur.
# - RESEND_API_KEY      : clé API Resend (re_...).
# - RESEND_FROM_EMAIL   : expéditeur vérifié sur Resend (ex. "Payback <relances@mondomaine.com>").
# - RESEND_TEST_RECIPIENT : seule adresse qui reçoit les emails de test à cette étape.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_RECIPIENT=

# Paiement (Stripe)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# SMS (Twilio)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""

# Cron (Vercel Cron Jobs)
# CRON_SECRET=""   # Secret partagé avec Vercel Cron (Authorization: Bearer)

# Paiement (Lemon Squeezy)
# LEMONSQUEEZY_API_KEY=""
# LEMONSQUEEZY_STORE_ID=""
# LEMONSQUEEZY_WEBHOOK_SECRET=""
# LEMONSQUEEZY_VARIANT_STARTER=""
# LEMONSQUEEZY_VARIANT_PRO=""
