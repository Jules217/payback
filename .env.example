# ──────────────────────────────────────────────────────────────
# Payback — variables d'environnement (exemple)
# Copier ce fichier en `.env` et remplir les valeurs.
# Aucune de ces variables n'est requise pour lancer l'app en local
# dans son état actuel (placeholders), elles préparent l'étape suivante.
# ──────────────────────────────────────────────────────────────

# Base de données (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/payback?schema=public"
# Pour Supabase, ajouter aussi l'URL de connexion directe (migrations)
DIRECT_URL="postgresql://user:password@localhost:5432/payback?schema=public"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Étapes futures (laisser vide pour l'instant) ──────────────
# Auth (Supabase)
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Email (Resend)
# RESEND_API_KEY=""

# Paiement (Stripe)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# SMS (Twilio)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
