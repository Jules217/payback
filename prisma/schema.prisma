// Payback — schéma de base de données
// Les modèles reflètent les types métier définis dans `types/index.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Utilisateur ───────────────────────────────────────────────
// Géré manuellement pour l'instant (auth Supabase à venir).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

// ── Organisation (tenant) ─────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  name      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           Membership[]
  clients           Client[]
  invoices          Invoice[]
  payments          Payment[]
  reminderSequences ReminderSequence[]
  messageTemplates  MessageTemplate[]
  reminderEvents    ReminderEvent[]
}

// Lien utilisateur <-> organisation
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(OWNER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

// ── Clients (débiteurs) ───────────────────────────────────────
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  companyName      String?
  email            String?
  phone            String?
  preferredChannel PreferredChannel @default(EMAIL)
  language         Language         @default(FR)
  status           ClientStatus     @default(ACTIVE)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  invoices Invoice[]

  @@index([organizationId])
  @@index([organizationId, status])
}

enum PreferredChannel {
  EMAIL
  SMS
  BOTH
}

enum Language {
  FR
  EN
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

// ── Factures ──────────────────────────────────────────────────
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  number      String
  amountCents Int
  currency    String        @default("CAD")
  issuedAt    DateTime      @default(now())
  dueAt       DateTime
  status      InvoiceStatus @default(PENDING)
  paymentUrl  String?
  description String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reminderEvents ReminderEvent[]
  payments       Payment[]

  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PENDING
  OVERDUE
  PAID
  CANCELLED
}

// ── Paiements ─────────────────────────────────────────────────
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String        @default("EUR")
  method      PaymentMethod @default(OTHER)
  paidAt      DateTime      @default(now())
  note        String?
  createdAt   DateTime      @default(now())

  @@index([organizationId])
  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHECK
  OTHER
}

// ── Scénarios de relance ──────────────────────────────────────
model ReminderSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ReminderStep[]

  @@index([organizationId])
}

model ReminderStep {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   ReminderSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Décalage en jours par rapport à l'échéance (négatif = avant, positif = après)
  offsetDays Int
  channel    ReminderChannel @default(EMAIL)
  order      Int             @default(0)
  isActive   Boolean         @default(true)

  @@index([sequenceId])
}

enum ReminderChannel {
  EMAIL
  SMS
}

// ── Modèles de message ────────────────────────────────────────
model MessageTemplate {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  name      String
  subject   String?
  body      String
  channel   ReminderChannel @default(EMAIL)
  tone      ReminderTone    @default(PROFESSIONAL)
  language  Language        @default(FR)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  steps ReminderStep[]

  @@index([organizationId])
}

enum ReminderTone {
  GENTLE
  PROFESSIONAL
  FIRM
}

// ── Journal des relances ──────────────────────────────────────
model ReminderEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  channel        ReminderChannel
  status         ReminderEventStatus @default(SCHEDULED)
  scheduledAt    DateTime
  sentAt         DateTime?
  /** Décalage de l'étape déclenchante (J+7 → 7), pour l'historique et l'anti-doublon. */
  offsetDays     Int?
  messageSubject String?
  messageBody    String?
  /** Identifiant du message renvoyé par le fournisseur (Resend) en cas de succès. */
  providerMessageId String?
  /** Message d'erreur en cas d'échec d'envoi (status FAILED). */
  errorMessage      String?
  createdAt      DateTime            @default(now())

  @@index([organizationId])
  @@index([invoiceId])
}

enum ReminderEventStatus {
  SCHEDULED
  SIMULATED
  SENT
  FAILED
  CANCELLED
}
