// Payback — schéma de base de données
// Les modèles reflètent les types métier définis dans `types/index.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Utilisateur ───────────────────────────────────────────────
// Géré manuellement pour l'instant (auth Supabase à venir).
model User {
  id         String   @id @default(cuid())
  supabaseId String?  @unique
  email      String   @unique
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships Membership[]
}

// ── Organisation (tenant) ─────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  name      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Configuration d'envoi email ───────────────────────────────
  // Opt-in explicite : tant que false, aucun email ne peut partir vers
  // `client.email` (seuls la simulation locale et l'email de test restent
  // possibles). Voir docs/EMAIL_DELIVERY.md.
  emailSendingEnabled Boolean @default(false)
  /** Nom d'expéditeur affiché (remplace le display name de RESEND_FROM_EMAIL). */
  emailFromName String?
  /** Adresse reply-to appliquée aux relances envoyées aux clients. */
  emailReplyTo String?
  /** Envoi automatique par le cron : si true, le cron envoie sans intervention manuelle. */
  autoSendEnabled Boolean @default(false)

  // ── Abonnement Lemon Squeezy ──────────────────────────────────
  lemonSqueezyCustomerId     String?
  lemonSqueezySubscriptionId String?
  subscriptionStatus         SubscriptionStatus @default(INACTIVE)
  subscriptionEndsAt         DateTime?
  subscriptionPlan           SubscriptionPlan?

  // ── Quota d'envois journalier (Bloc 4 anti-abus) ──────────────
  /** Nombre d'emails réels (CLIENT) envoyés le jour `emailsSentDate`. */
  emailsSentToday Int       @default(0)
  /** Jour courant du compteur (date à minuit UTC, pas un datetime d'envoi). */
  emailsSentDate  DateTime?

  members           Membership[]
  clients           Client[]
  invoices          Invoice[]
  payments          Payment[]
  reminderSequences ReminderSequence[]
  messageTemplates  MessageTemplate[]
  reminderEvents    ReminderEvent[]
}

// Lien utilisateur <-> organisation
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(OWNER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

// ── Clients (débiteurs) ───────────────────────────────────────
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  companyName      String?
  email            String?
  phone            String?
  preferredChannel PreferredChannel @default(EMAIL)
  language         Language         @default(FR)
  status           ClientStatus     @default(ACTIVE)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  invoices Invoice[]

  @@index([organizationId])
  @@index([organizationId, status])
}

enum PreferredChannel {
  EMAIL
  SMS
  BOTH
}

enum Language {
  FR
  EN
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

// ── Factures ──────────────────────────────────────────────────
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  number      String
  amountCents Int
  currency    String        @default("CAD")
  issuedAt    DateTime      @default(now())
  dueAt       DateTime
  status      InvoiceStatus @default(PENDING)
  paymentUrl  String?
  description String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reminderEvents ReminderEvent[]
  payments       Payment[]

  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PENDING
  OVERDUE
  PAID
  CANCELLED
}

// ── Paiements ─────────────────────────────────────────────────
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String        @default("EUR")
  method      PaymentMethod @default(OTHER)
  paidAt      DateTime      @default(now())
  note        String?
  createdAt   DateTime      @default(now())

  @@index([organizationId])
  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHECK
  OTHER
}

// ── Scénarios de relance ──────────────────────────────────────
model ReminderSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ReminderStep[]

  @@index([organizationId])
}

model ReminderStep {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   ReminderSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Décalage en jours par rapport à l'échéance (négatif = avant, positif = après)
  offsetDays Int
  channel    ReminderChannel @default(EMAIL)
  order      Int             @default(0)
  isActive   Boolean         @default(true)

  @@index([sequenceId])
}

enum ReminderChannel {
  EMAIL
  SMS
}

// ── Modèles de message ────────────────────────────────────────
model MessageTemplate {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  name      String
  subject   String?
  body      String
  channel   ReminderChannel @default(EMAIL)
  tone      ReminderTone    @default(PROFESSIONAL)
  language  Language        @default(FR)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  steps ReminderStep[]

  @@index([organizationId])
}

enum ReminderTone {
  GENTLE
  PROFESSIONAL
  FIRM
}

// ── Journal des relances ──────────────────────────────────────
model ReminderEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  channel        ReminderChannel
  status         ReminderEventStatus @default(SCHEDULED)
  scheduledAt    DateTime
  sentAt         DateTime?
  /**
   * Horodatage du claim atomique (passage SCHEDULED → SENDING par un run d'envoi).
   * Sert à récupérer un event coincé en SENDING : si claimedAt < now-15min, le run
   * suivant peut le re-claim (crash en plein envoi). Remis à now à chaque claim.
   */
  claimedAt      DateTime?
  /** Décalage de l'étape déclenchante (J+7 → 7), pour l'historique et l'anti-doublon. */
  offsetDays     Int?
  messageSubject String?
  messageBody    String?
  /** Identifiant du message renvoyé par le fournisseur (Resend) en cas de succès. */
  providerMessageId String?
  /** Message d'erreur en cas d'échec d'envoi (status FAILED). */
  errorMessage      String?
  /** Adresse réellement (ou théoriquement) destinataire, pour savoir où l'email est parti. */
  recipientEmail    String?
  /** Distingue simulation locale, email de test et envoi réel au client. */
  deliveryMode      ReminderDeliveryMode?
  createdAt      DateTime            @default(now())

  // Anti-doublon : index UNIQUE PARTIEL `uniq_reminder_active` posé en SQL
  // (migration reminder_queue) — unicité (invoiceId, offsetDays, deliveryMode)
  // limitée aux status SCHEDULED/SENT. Prisma ne sait pas exprimer un index
  // partiel, d'où l'absence de @@unique ici ; voir prisma/migrations.
  @@index([organizationId])
  @@index([invoiceId])
}

enum ReminderEventStatus {
  SCHEDULED
  SENDING // claim atomique en cours d'envoi ; récupérable si bloqué (claimedAt < now-15min)
  SIMULATED
  SENT
  FAILED
  CANCELLED
}

/** Mode d'acheminement d'un ReminderEvent (où/comment l'email est parti). */
enum ReminderDeliveryMode {
  SIMULATION
  TEST
  CLIENT
}

// ── Abonnement Lemon Squeezy ──────────────────────────────────

enum SubscriptionStatus {
  INACTIVE  // jamais souscrit ou expiré
  TRIALING  // essai gratuit en cours
  ACTIVE    // abonnement actif payant
  PAST_DUE  // paiement en échec
  CANCELLED // annulé, accès jusqu'à subscriptionEndsAt
}

enum SubscriptionPlan {
  STARTER
  PRO
}

// ── Rate-limit des emails de test ─────────────────────────────
// Fenêtre glissante simple : on compte les lignes de l'heure écoulée.
// Pas de FK vers Organization/Invoice : journal volatil, on évite de
// bloquer la suppression d'une facture sur ce log.
model EmailTestLog {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  sentAt         DateTime @default(now())

  @@index([organizationId, sentAt])
  @@index([invoiceId, sentAt])
}

// ── Idempotence des webhooks ──────────────────────────────────
// Anti-rejeu : chaque événement Lemon Squeezy traité est enregistré ici.
// L'index @unique sur eventId fait office de garde — c'est la DB qui rejette
// tout doublon (P2002), pas un test applicatif, donc un rejeu reste bloqué même
// si le premier traitement est encore en cours.
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique // id (composite) de l'événement Lemon Squeezy
  eventName   String // ex. subscription_created
  processedAt DateTime @default(now())
}
